<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino3_v6_robot">
  <xacro:arg name="left_prefix" default="left_" />
  <xacro:arg name="right_prefix" default="right_" />
  <xacro:arg name="arm_spacing" default="0.75" />
  <!-- <xacro:arg name="initial_positions_file"
           default="$(find fairino_description)/config/initial_positions.yaml"/>
  <xacro:arg name="ros2_controllers_file"
           default="$(find fairino_description)/config/ros2_controllers.yaml"/> -->

  <xacro:arg name="floor_size_x" default="4.0" />
  <xacro:arg name="floor_size_y" default="4.0" />
  <xacro:arg name="floor_thickness" default="0.1" />

  <xacro:include
    filename="$(find fairino_description)/urdf_dual_arms/fairino3_v6_robot.prefixed.urdf.xacro" />

  <xacro:property name="left_prefix" value="$(arg left_prefix)" />
  <xacro:property name="right_prefix" value="$(arg right_prefix)" />
  <xacro:property name="arm_spacing" value="$(arg arm_spacing)" />
  <!-- <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>
  <xacro:property name="ros2_controllers_file" value="$(arg ros2_controllers_file)"/> -->
  <xacro:property name="floor_size_x" value="$(arg floor_size_x)" />
  <xacro:property name="floor_size_y" value="$(arg floor_size_y)" />
  <xacro:property name="floor_thickness" value="$(arg floor_thickness)" />


  <link name="world" />

  <link name="floor_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${floor_size_x} ${floor_size_y} ${floor_thickness}" />
      </geometry>
    </collision>
  </link>
  <joint name="world_to_floor" type="fixed">
    <parent link="world" />
    <child link="floor_link" />
    <origin xyz="0 0 ${-float(floor_thickness)/2.0 - 0.001}" rpy="0 0 0" />
  </joint>
  <joint name="world_to_left_base" type="fixed">
    <parent link="world" />
    <child link="${left_prefix}base_link" />
    <origin xyz="0 0 0" rpy="0 0 -1.5708" />
  </joint>
  <joint name="world_to_right_base" type="fixed">
    <parent link="world" />
    <child link="${right_prefix}base_link" />
    <origin xyz="0 ${-float(arm_spacing)} 0" rpy="0 0 -1.5708" />
  </joint>


  <!-- 1. The Camera Visual Box -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.05 0.05 0.03" />
      </geometry>
      <material name="camera_grey">
        <color rgba="0.5 0.5 0.5 1.0" />
      </material>
    </visual>
    <!-- Add minimal inertial to prevent disconnected graph errors -->
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
  </link>

  <!-- 2. Optical Frame -->
  <link name="camera_optical_frame">
    <inertial>
      <mass value="0.01" />
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
    </inertial>
  </link>

  <!-- 3. Joint to connect camera_link to the world -->
  <joint name="world_to_camera" type="fixed">
    <parent link="world" />
    <child link="camera_link" />
    <origin xyz="0 -0.375 0.6" rpy="0 0 0" />
  </joint>

  <!-- 4. Joint to orient the optical frame relative to the camera box -->
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link" />
    <child link="camera_optical_frame" />
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966" />
  </joint>
  <!-- 5. Gazebo settings to make it "ghost-like" (stable) -->
  <!-- <gazebo reference="camera_link">
    <static>true</static>
    <turnGravityOff>true</turnGravityOff>
  </gazebo> -->

  <!-- Left + Right arms -->
  <xacro:fairino3_v6_robot_prefixed prefix="${left_prefix}"
    joint1_angle="-1.5708"
    joint2_angle="1.5708"
    joint3_angle="-1.5708"
    joint4_angle="3.14159"
    joint5_angle="3.14159"
    joint6_angle="0.0" />

  <xacro:fairino3_v6_robot_prefixed prefix="${right_prefix}"
    joint1_angle="1.5708"
    joint2_angle="1.5708"
    joint3_angle="1.5708"
    joint4_angle="0.0"
    joint5_angle="-3.14159"
    joint6_angle="0.0" />


  <!-- ros2_control (single system with 12 joints) -->

  <ros2_control name="dual_arms_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>

    <!-- Left arm joints -->
    <joint name="${left_prefix}joint1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${left_prefix}joint2">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${left_prefix}joint3">
      <!-- <command_interfaces><position/></command_interfaces> -->
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${left_prefix}joint4">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${left_prefix}joint5">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${left_prefix}joint6">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <!-- Right arm joints -->
    <joint name="${right_prefix}joint1">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${right_prefix}joint2">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${right_prefix}joint3">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${right_prefix}joint4">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${right_prefix}joint5">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="${right_prefix}joint6">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="/opt/ros/humble/lib/libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find fairino_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>