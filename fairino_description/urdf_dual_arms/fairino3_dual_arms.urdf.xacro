<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino3_v6_robot">
  <xacro:arg name="left_prefix" default="left_" />
  <xacro:arg name="right_prefix" default="right_" />
  <xacro:arg name="arm_spacing" default="0.75" />
  <xacro:arg name="left_robot_ip" default="192.168.58.2" />
  <xacro:arg name="right_robot_ip" default="192.168.58.3" />
  <xacro:arg name="platform_length" default="0.90" />
  <xacro:arg name="platform_width" default="0.58" />
  <xacro:arg name="platform_height" default="0.05" />
  <xacro:arg name="platform_bottom_z" default="0.61" />
  <xacro:arg name="camera_world_x" default="0.45" />
  <xacro:arg name="camera_world_y" default="0.59" />
  <xacro:arg name="camera_world_z" default="0.61" />
  <xacro:arg name="floor_length" default="1.8" />
  <xacro:arg name="floor_width" default="1.16" />
  <xacro:arg name="floor_height" default="0.05" />
  <xacro:include
    filename="$(find fairino_description)/urdf_dual_arms/fairino3_v6_robot.prefixed.urdf.xacro" />
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro" />
  <xacro:property name="left_prefix" value="$(arg left_prefix)" />
  <xacro:property name="right_prefix" value="$(arg right_prefix)" />
  <xacro:property name="arm_spacing" value="$(arg arm_spacing)" />
  <xacro:property name="left_robot_ip" value="$(arg left_robot_ip)" />
  <xacro:property name="right_robot_ip" value="$(arg right_robot_ip)" />
  <xacro:property name="platform_length" value="$(arg platform_length)" />
  <xacro:property name="platform_width" value="$(arg platform_width)" />
  <xacro:property name="platform_height" value="$(arg platform_height)" />
  <xacro:property name="platform_bottom_z" value="$(arg platform_bottom_z)" />
  <xacro:property name="camera_world_x" value="$(arg camera_world_x)" />
  <xacro:property name="camera_world_y" value="$(arg camera_world_y)" />
  <xacro:property name="camera_world_z" value="$(arg camera_world_z)" />
  <xacro:property name="floor_length" value="$(arg floor_length)" />
  <xacro:property name="floor_width" value="$(arg floor_width)" />
  <xacro:property name="floor_height" value="$(arg floor_height)" />
  <xacro:arg name="initial_positions_file"
    default="$(find fairino_description)/config/initial_positions.yaml" />
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)" />
  <xacro:property name="initial_positions"
    value="${xacro.load_yaml(initial_positions_file)['initial_positions']}" />

  <link name="world" />

  <link name="dual_arm_center" />

  <joint name="world_to_center" type="fixed">
    <parent link="world" />
    <child link="dual_arm_center" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="floor_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${floor_length} ${floor_width} ${floor_height}" />
      </geometry>
      <material name="floor_grey">
        <color rgba="0.35 0.35 0.35 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${floor_length} ${floor_width} ${floor_height}" />
      </geometry>
    </collision>

    <!-- Keep the fixed floor link and its collision during URDF-to-SDF conversion. -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.0" />
      <inertia
        ixx="${(float(floor_width) * float(floor_width) + float(floor_height) * float(floor_height)) / 12.0}"
        ixy="0" ixz="0"
        iyy="${(float(floor_length) * float(floor_length) + float(floor_height) * float(floor_height)) / 12.0}"
        iyz="0"
        izz="${(float(floor_length) * float(floor_length) + float(floor_width) * float(floor_width)) / 12.0}" />
    </inertial>
  </link>

  <joint name="world_to_floor" type="fixed">
    <parent link="world" />
    <child link="floor_link" />
    <origin xyz="0.45 0.58 ${-float(floor_height)/2.0}" rpy="0 0 0" />
  </joint>

  <link name="platform_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${platform_length} ${platform_width} ${platform_height}" />
      </geometry>
      <material name="platform_grey">
        <color rgba="0.45 0.45 0.45 1.0" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="${platform_length} ${platform_width} ${platform_height}" />
      </geometry>
    </collision>
  </link>
  <joint name="world_to_platform" type="fixed">
    <parent link="world" />
    <child link="platform_link" />
    <origin
      xyz="${float(platform_length)/2.0} ${float(platform_width)/2.0} ${float(platform_bottom_z) + float(platform_height)/2.0}"
      rpy="0 0 0" />
  </joint>

  <!-- RealSense body frame: +X forward/view direction, +Y left, +Z up. -->
  <xacro:sensor_d435i parent="world" name="d435i">
    <origin xyz="${camera_world_x} ${camera_world_y} ${camera_world_z}"
      rpy="0 1.16937 1.57079632679" />
  </xacro:sensor_d435i>

  <joint name="world_to_left_base" type="fixed">
    <parent link="world" />
    <child link="${left_prefix}base_link" />
    <origin xyz="0.075 0.48 ${platform_bottom_z}" rpy="3.14159 0 0" />
  </joint>
  <joint name="world_to_right_base" type="fixed">
    <parent link="world" />
    <child link="${right_prefix}base_link" />
    <origin xyz="0.825 0.48 ${platform_bottom_z}" rpy="3.14159 0 0" />
  </joint>

  <!-- Left + Right arms -->
  <xacro:fairino3_v6_robot_prefixed prefix="${left_prefix}"
    grasp_roll="0.0"
    grasp_pitch="-1.57079632679"
    grasp_yaw="1.57079632679" />
  <xacro:fairino3_v6_robot_prefixed prefix="${right_prefix}"
    grasp_roll="0.0"
    grasp_pitch="-1.57079632679"
    grasp_yaw="1.57079632679" />

  <!-- ros2_control (single system with 12 joints for Gazebo Simulation) -->

  <ros2_control name="dual_arms_system" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- LEFT ARM JOINTS -->
    <joint name="${left_prefix}joint1">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint1']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${left_prefix}joint2">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint2']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${left_prefix}joint3">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint3']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${left_prefix}joint4">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint4']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${left_prefix}joint5">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint5']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${left_prefix}joint6">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[left_prefix + 'joint6']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <!-- RIGHT ARM JOINTS -->
    <joint name="${right_prefix}joint1">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint1']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${right_prefix}joint2">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint2']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${right_prefix}joint3">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint3']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${right_prefix}joint4">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint4']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${right_prefix}joint5">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint5']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>

    <joint name="${right_prefix}joint6">
      <command_interface name="position" />
      <state_interface name="position">
        <param name="initial_value">${initial_positions[right_prefix + 'joint6']}</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="/opt/ros/humble/lib/libign_ros2_control-system.so"
      name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(find fairino_description)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>